<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Update-Check (GitHub) und Vorlagen-Abgleich (IServ-WebDAV) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Abgleich nur, wenn Netz da ist -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Update-APK an den System-Installer übergeben -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Statt QUERY_ALL_PACKAGES: nur Apps mit Startsymbol und Widget-Anbieter sehen -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <supports-screens android:largeScreens="true" android:xlargeScreens="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.DammLauncher"
        android:largeHeap="false">

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="sensorLandscape"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Täglicher Vorlagen-Abgleich (nur das System darf ihn starten) -->
        <service
            android:name=".abgleich.AbgleichJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Übergibt die geladene Update-APK an den Installer (nicht exportiert, nur mit Freigabe) -->
        <provider
            android:name=".update.ApkProvider"
            android:authorities="de.oejendorferdamm.dammlauncher.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
