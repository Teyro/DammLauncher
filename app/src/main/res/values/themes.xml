<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Kein Fensterhintergrund vom System: den malt der Launcher selbst (spart einen Zeichenvorgang). -->
    <style name="Theme.DammLauncher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorAccent">#1E6FD9</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
